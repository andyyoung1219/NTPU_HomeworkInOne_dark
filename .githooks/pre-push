#!/bin/sh
set -eu

if [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe scripts/check_repository.py --pre-push
fi
if [ -x .venv/bin/python ]; then
    exec .venv/bin/python scripts/check_repository.py --pre-push
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/check_repository.py --pre-push
fi
exec python scripts/check_repository.py --pre-push
